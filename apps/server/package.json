{
  "name": "@flowforge/server",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./env-bootstrap": {
      "types": "./dist/env-bootstrap.d.ts",
      "import": "./dist/env-bootstrap.js"
    },
    "./services/*": {
      "types": "./dist/services/*.d.ts",
      "import": "./dist/services/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@flowforge/shared": "*",
    "@flowforge/engine": "*",
    "fastify": "^5.0.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "pg": "^8.13.0",
    "ioredis": "^5.4.0",
    "zod": "^3.23.0",
    "argon2": "^0.41.0",
    "uuid": "^10.0.0",
    "luxon": "^3.4.0",
    "cron-parser": "^4.9.0",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "@types/luxon": "^3.4.0",
    "typescript": "^5.7.0"
  }
}

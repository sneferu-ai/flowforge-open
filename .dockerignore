# Exclude test files, test keys, and dev-only artifacts from the Docker build
# context so they never enter the build stage or the runtime image.
**/*.test.ts
**/*.test.tsx
**/*.test.js
**/*.spec.ts
tests/
test-results/
playwright-report/
blob-report/
apps/server/src/test-keys/*.pem

# VCS / metadata
.git/
.gitignore
.github/

# Docs are not needed in the image
docs/
DESIGN.md
SOUL.md
IMPLEMENTATION_NOTES.md
test_plan.md

# Build artifacts (regenerated inside the image)
dist/
node_modules/
*.tsbuildinfo

# Environment / secrets — never bake into an image
.env
.env.*
**/*.pem
**/*.key
